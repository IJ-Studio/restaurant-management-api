# Plantilla de variables de entorno del API. Solo nombres: nunca escribas valores aquí.
# Copia este archivo como .env (ignorado por git) y complétalo en local; en Render, como variables del servicio.

# --- Servidor ---
# Puerto HTTP (por defecto 10000).
# PORT=
# "production" en el despliegue.
NODE_ENV=
# Orígenes permitidos por CORS, separados por comas (https://dominio,...). Vacío = los de siempre.
CORS_ORIGINS=

# --- Base de datos ---
# Conexión de la app (pooler de Supabase).
DATABASE_URL=
# "true" para exigir SSL en la conexión.
DATABASE_SSL=
# Conexión directa que usa drizzle-kit para migraciones (drizzle.config.ts).
DATABASE_MIGRATION_URL=

# --- Autenticación ---
# Secreto de firma del JWT. Debe ser el mismo que usa la web para verificar la sesión.
JWT_SECRET=
# Vida del token de acceso, en segundos (por defecto 3600).
JWT_ACCESS_TOKEN_TTL=

# --- Supabase (respaldos y almacenamiento) ---
SUPABASE_URL=
# Clave service_role: solo en el servidor, nunca en la web ni en la app.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket de respaldos (por defecto "backups").
# SUPABASE_BACKUPS_BUCKET=

# --- Cloudinary (firma de subida de imágenes) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Pagos y facturación ---
# Clave secreta de Stripe (sk_...).
STRIPE_SECRET_KEY=
# Secreto del webhook de Stripe (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Clave de Facturapi (modo de pruebas).
FACTURAPI_TEST_KEY=

# --- Cifrado de campos sensibles (src/common/cifrado) ---
# Claves AES-256 por versión: "1:<32 bytes en base64>,2:<...>".
CIFRADO_CLAVES=
# Versión con la que se cifra (por defecto 1).
CIFRADO_VERSION=
# Clave del índice ciego (HMAC-SHA256).
CIFRADO_HMAC_CLAVE=
# "true" para guardar cifrado. Mantener en false hasta que web y app lean los valores cifrados.
CIFRADO_ESCRIBIR=

# --- Funciones opcionales ---
# "true" activa la predicción de ausencias en reservaciones.
# PREDICCION_NO_SHOW_ACTIVA=

# --- Firewall Aikido (@aikidosec/firewall, importado en main.ts) ---
# Token del panel de Aikido; vacío = solo protección local.
# AIKIDO_TOKEN=
# "true" para bloquear los ataques detectados en vez de solo reportarlos.
# AIKIDO_BLOCK=

# Peticiones por minuto por IP (por defecto 40). Todo el restaurante comparte una IP.
THROTTLE_LIMIT=
