# Copiar como .env y rellenar con valores reales. Este archivo solo debe
# contener placeholders — nunca credenciales reales, ni siquiera de
# desarrollo (ver README.md para instrucciones de instalación completas).

# ── Servidor ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=10000

# ── Base de datos (Supabase Postgres vía Drizzle) ──────────────────────
# DATABASE_URL: conexión vía pooler de Supabase en modo "transaction"
# (puerto 6543), usada en tiempo de ejecución por el backend.
DATABASE_URL=postgresql://usuario:contraseña@host:6543/postgres
# DATABASE_MIGRATION_URL: conexión directa (puerto 5432, sin pooler), usada
# solo por drizzle-kit para generar/aplicar migraciones.
DATABASE_MIGRATION_URL=postgresql://usuario:contraseña@host:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=5000

# ── Autenticación (JWT) ─────────────────────────────────────────────────
JWT_SECRET=reemplazar-con-una-cadena-aleatoria-larga
JWT_ACCESS_TOKEN_TTL=15m

# ── Supabase (Storage / Service Role) ──────────────────────────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=reemplazar-con-la-service-role-key
SUPABASE_BACKUPS_BUCKET=backups

# ── Respaldo a Google Drive (opcional, backups.service.ts) ─────────────
GOOGLE_CLIENT_EMAIL=cuenta-de-servicio@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreemplazar\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=reemplazar-con-el-id-de-carpeta

# ── Pagos (Stripe) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_reemplazar
STRIPE_WEBHOOK_SECRET=whsec_reemplazar

# ── Facturación (Facturapi) ─────────────────────────────────────────────
FACTURAPI_TEST_KEY=reemplazar-con-la-api-key-de-pruebas

# ── Seguridad en runtime (Aikido Firewall, ver src/main.ts) ────────────
AIKIDO_TOKEN=reemplazar-con-el-token-de-aikido
